{
	"name": "georgringer/numbered-pagination",
	"type": "typo3-cms-extension",
	"description": "Improved pagination for TYPO3",
	"keywords": [
		"TYPO3",
		"pagination"
	],
	"homepage": "https://github.com/georgringer/numbered_pagination",
	"authors": [
		{
			"name": "Georg Ringer",
			"role": "Developer"
		}
	],
	"license": "GPL-2.0-or-later",
	"require": {
		"typo3/cms-core": "^9 || ^10 || ^11 || ^12 || ^13 || ^14",
		"php": ">=7.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^10 || ^11"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "numbered_pagination",
			"version": "2.2.1-dev",
			"Package": {
				"providesPackages": []
			}
		}
	},
	"autoload": {
		"psr-4": {
			"GeorgRinger\\NumberedPagination\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GeorgRinger\\NumberedPagination\\Tests\\": "Tests"
		}
	},
	"replace": {
		"typo3-ter/numbered-pagination": "self.version"
	}
}
